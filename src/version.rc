/* SPDX-License-Identifier: Apache-2.0 */
/* version.rc - Windows version resource for vmnet-cli.exe.
 * Version parts default to pyproject's 0.1.0; the release workflow overrides
 * them from the tag with -DVER_MAJOR= -DVER_MINOR= -DVER_PATCH=. */
#include <winver.h>

#ifndef VER_MAJOR
#define VER_MAJOR 0
#endif
#ifndef VER_MINOR
#define VER_MINOR 1
#endif
#ifndef VER_PATCH
#define VER_PATCH 0
#endif

#define STR2(x) #x
#define STR(x)  STR2(x)
#define VER_STR STR(VER_MAJOR) "." STR(VER_MINOR) "." STR(VER_PATCH)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR,VER_MINOR,VER_PATCH,0
 PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"          /* en-US, Unicode */
        BEGIN
            VALUE "CompanyName",      "fl0l0u"
            VALUE "FileDescription",  "vmnet-cli - unofficial VMware Workstation Virtual Network Editor CLI"
            VALUE "FileVersion",      VER_STR
            VALUE "InternalName",     "vmnet-cli"
            VALUE "LegalCopyright",   "Copyright 2026 fl0l0u. Licensed under the Apache License 2.0."
            VALUE "OriginalFilename", "vmnet-cli.exe"
            VALUE "ProductName",      "vmnet-cli"
            VALUE "ProductVersion",   VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
